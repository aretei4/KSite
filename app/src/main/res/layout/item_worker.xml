<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="8dp" app:cardCornerRadius="10dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/iv_photo" android:layout_width="48dp"
            android:layout_height="48dp" android:scaleType="centerCrop"
            android:background="@color/soft_blue" android:visibility="gone"
            android:layout_marginEnd="12dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="14sp"
                android:textStyle="bold" android:textColor="@color/text_primary"/>
            <TextView android:id="@+id/tv_wage" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/tv_address" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="@color/text_secondary" android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
        <Button android:id="@+id/btn_edit" android:layout_width="50dp"
            android:layout_height="32dp" android:text="Edit" android:textSize="11sp"
            style="@style/Widget.AppCompat.Button.Borderless" android:textColor="@color/accent"/>
        <Button android:id="@+id/btn_delete" android:layout_width="50dp"
            android:layout_height="32dp" android:text="Del" android:textSize="11sp"
            style="@style/Widget.AppCompat.Button.Borderless" android:textColor="@color/red"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
