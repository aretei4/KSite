<?xml version="1.0" encoding="utf-8"?>
<!-- item_payment.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/card"
    android:padding="14dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/text_primary"/>
        <TextView android:id="@+id/tv_sub" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_amount" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="15sp"
        android:textStyle="bold" android:textColor="@color/green"
        android:layout_gravity="center_vertical"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="10dp"
        android:layout_gravity="center_vertical">
        <Button android:id="@+id/btn_edit" android:layout_width="40dp"
            android:layout_height="28dp" android:text="✏" android:textSize="12sp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
        <Button android:id="@+id/btn_delete" android:layout_width="40dp"
            android:layout_height="28dp" android:text="🗑" android:textSize="12sp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </LinearLayout>
</LinearLayout>
